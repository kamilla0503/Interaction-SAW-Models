+void hierarchicalDeltaE_1(const Kokkos::TeamPolicy<Kokkos::Cuda>::member_type &team_member,
+                          const FlipMoveData &flip_data)
+{
+    // Endpoints (old/new) trigs once per team, reused for all i
+    const coord_t pos_j = flip_data.oldIndex();
+    const float   theta_j = flip_data.oldspin(0);
+    const coord_t pos_k = flip_data.newIndex();
+    const float   theta_k = flip_data.sequence_on_lattice(pos_k);
+
+    float cos_j, sin_j, cos_k, sin_k;
+#if defined(__CUDA_ARCH__)
+    sincosf(theta_j, &sin_j, &cos_j);
+    sincosf(theta_k, &sin_k, &cos_k);
+#else
+    sin_j = std::sin(theta_j); cos_j = std::cos(theta_j);
+    sin_k = std::sin(theta_k); cos_k = std::cos(theta_k);
+#endif
+
+    Kokkos::parallel_reduce(
+        Kokkos::TeamThreadRange(team_member, flip_data.L()),
+        [&](const int i, float &H_total) {
+            const coord_t pos_i = flip_data.lattice_nodes_positions(i);
+            if (pos_i == pos_j || pos_i == pos_k) return;
+
+            const float theta_i = flip_data.sequence_on_lattice(pos_i);
+            float sin_i, cos_i;
+#if defined(__CUDA_ARCH__)
+            sincosf(theta_i, &sin_i, &cos_i);
+#else
+            sin_i = std::sin(theta_i); cos_i = std::cos(theta_i);
+#endif
+            // Dot products avoid two expensive cos(theta_i - •) calls
+            float r_ij = radius(pos_i, pos_j, flip_data.lattice_side_device(), flip_data);
+            r_ij = Kokkos::sqrt(r_ij) * r_ij;
+            H_total += (cos_i * cos_j + sin_i * sin_j) / r_ij;
+
+            float r_ik = radius(pos_i, pos_k, flip_data.lattice_side_device(), flip_data);
+            r_ik = Kokkos::sqrt(r_ik) * r_ik;
+            H_total -= (cos_i * cos_k + sin_i * sin_k) / r_ik;
+        },
+        flip_data.d_E_1());
+}
 
 
 KOKKOS_INLINE_FUNCTION
